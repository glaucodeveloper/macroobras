proc carregarConfiguracaoMobileLocal() =
  let envPath = appRootDir() / "config" / "mobile-platform.env"
  let values = readSimpleEnvFile(envPath)
  for key, value in values.pairs:
    if getEnv(key).len == 0:
      putEnv(key, value.getStr(""))

