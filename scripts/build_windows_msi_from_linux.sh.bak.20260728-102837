#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD="$ROOT/build/windows-cross"
PACKAGE_DIR="$BUILD/MacroObras"
BIN="$PACKAGE_DIR/bin"
WORK_DIR="$BUILD/msi"
VERSION="${1:-${MACROOBRAS_VERSION:-1.0.0}}"
MSI="$BUILD/MacroObras-Setup-Windows-x64-${VERSION}.msi"
WXS="$WORK_DIR/MacroObras-${VERSION}.wxs"
SHA256="$MSI.sha256"

die() {
  printf 'ERRO: %s\n' "$*" >&2
  exit 1
}

command -v python3 >/dev/null 2>&1 ||
  die "python3 não encontrado."

command -v wixl >/dev/null 2>&1 ||
  die "wixl não encontrado. Instale com: sudo pacman -S --needed msitools"

command -v msiinfo >/dev/null 2>&1 ||
  die "msiinfo não encontrado. Instale com: sudo pacman -S --needed msitools"

command -v msiextract >/dev/null 2>&1 ||
  die "msiextract não encontrado. Instale com: sudo pacman -S --needed msitools"

[[ -d "$PACKAGE_DIR" ]] ||
  die "pacote Windows ausente: $PACKAGE_DIR"

REQUIRED_FILES=(
  "$BIN/MacroObras.exe"
  "$BIN/sqlite3_64.dll"
  "$BIN/libssl-1_1-x64.dll"
  "$BIN/libcrypto-1_1-x64.dll"
  "$BIN/cacert.pem"
  "$BIN/ngrok.exe"
)

for required_file in "${REQUIRED_FILES[@]}"; do
  [[ -f "$required_file" ]] ||
    die "dependência ausente no pacote: $required_file"
done

mkdir -p "$WORK_DIR"
rm -f "$WXS" "$MSI" "$SHA256"

python3 - "$PACKAGE_DIR" "$WXS" "$VERSION" <<'PY'
from __future__ import annotations

import hashlib
import re
import sys
import uuid
from pathlib import Path
from xml.dom import minidom
from xml.etree import ElementTree as ET

source_dir = Path(sys.argv[1]).resolve()
output_wxs = Path(sys.argv[2]).resolve()
version = sys.argv[3].strip()

match = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)", version)
if not match:
    raise SystemExit(
        "ERRO: versão MSI inválida. Use major.minor.build, por exemplo 1.0.0."
    )

major, minor, build = map(int, match.groups())
if major > 255 or minor > 255 or build > 65535:
    raise SystemExit(
        "ERRO: versão fora dos limites MSI: major/minor <= 255 e build <= 65535."
    )

required = [
    "bin/MacroObras.exe",
    "bin/sqlite3_64.dll",
    "bin/libssl-1_1-x64.dll",
    "bin/libcrypto-1_1-x64.dll",
    "bin/cacert.pem",
    "bin/ngrok.exe",
]

for relative in required:
    if not (source_dir / relative).is_file():
        raise SystemExit(f"ERRO: arquivo obrigatório ausente: {relative}")

excluded_names = {
    "browser-wine.log",
    "desktop.ini",
    "thumbs.db",
}

excluded_suffixes = {
    ".log",
    ".tmp",
    ".bak",
    ".msi",
    ".zip",
    ".sha256",
}

files: list[Path] = []
for path in sorted(source_dir.rglob("*")):
    if not path.is_file():
        continue

    relative = path.relative_to(source_dir)
    lower_name = path.name.lower()

    if lower_name in excluded_names:
        continue

    if path.suffix.lower() in excluded_suffixes:
        continue

    files.append(relative)

if not files:
    raise SystemExit("ERRO: nenhum arquivo foi localizado para o MSI.")

WIX_NS = "http://schemas.microsoft.com/wix/2006/wi"
ET.register_namespace("", WIX_NS)

def q(tag: str) -> str:
    return f"{{{WIX_NS}}}{tag}"

def stable_uuid(text: str) -> str:
    namespace = uuid.UUID("ba8a4cd4-d520-4d3b-8fea-e8d6702e15af")
    return str(uuid.uuid5(namespace, text)).upper()

def stable_id(prefix: str, text: str) -> str:
    digest = hashlib.sha1(text.encode("utf-8")).hexdigest()[:24].upper()
    return f"{prefix}_{digest}"

upgrade_code = stable_uuid("MacroObras:UpgradeCode")
product_code = stable_uuid(f"MacroObras:Product:{version}")

wix = ET.Element(q("Wix"))

product = ET.SubElement(
    wix,
    q("Product"),
    {
        "Id": product_code,
        "Name": "MacroObras",
        "Language": "1046",
        "Codepage": "1252",
        "Version": version,
        "Manufacturer": "Maximus Empreendimentos",
        "UpgradeCode": upgrade_code,
    },
)

ET.SubElement(
    product,
    q("Package"),
    {
        "Id": "*",
        "Keywords": "Installer",
        "Description": f"Instalador do MacroObras {version}",
        "Comments": "ERP da construção Maximus Empreendimentos",
        "Manufacturer": "Maximus Empreendimentos",
        "InstallerVersion": "500",
        "Languages": "1046",
        "Compressed": "yes",
        "SummaryCodepage": "1252",
        "InstallScope": "perMachine",
        "Platform": "x64",
    },
)

ET.SubElement(
    product,
    q("Media"),
    {
        "Id": "1",
        "Cabinet": "MacroObras.cab",
        "EmbedCab": "yes",
    },
)

ET.SubElement(
    product,
    q("MajorUpgrade"),
    {
        "DowngradeErrorMessage": (
            "Uma versão mais recente do MacroObras já está instalada."
        ),
        "Schedule": "afterInstallInitialize",
    },
)

ET.SubElement(
    product,
    q("Property"),
    {
        "Id": "ALLUSERS",
        "Value": "1",
    },
)

condition = ET.SubElement(
    product,
    q("Condition"),
    {
        "Message": "O MacroObras requer Windows de 64 bits.",
    },
)
condition.text = "VersionNT64"

target = ET.SubElement(
    product,
    q("Directory"),
    {
        "Id": "TARGETDIR",
        "Name": "SourceDir",
    },
)

program_files = ET.SubElement(
    target,
    q("Directory"),
    {
        "Id": "ProgramFiles64Folder",
    },
)

install_folder = ET.SubElement(
    program_files,
    q("Directory"),
    {
        "Id": "INSTALLFOLDER",
        "Name": "MacroObras",
    },
)

program_menu = ET.SubElement(
    target,
    q("Directory"),
    {
        "Id": "ProgramMenuFolder",
    },
)

ET.SubElement(
    program_menu,
    q("Directory"),
    {
        "Id": "PROGRAMMENUDIR",
        "Name": "MacroObras",
    },
)

ET.SubElement(
    target,
    q("Directory"),
    {
        "Id": "DesktopFolder",
    },
)

directory_ids: dict[Path, str] = {Path("."): "INSTALLFOLDER"}
directory_elements: dict[Path, ET.Element] = {
    Path("."): install_folder
}

all_directories = sorted(
    {
        parent
        for relative in files
        for parent in relative.parents
        if parent != Path(".")
    },
    key=lambda p: (len(p.parts), p.as_posix().lower()),
)

for relative_dir in all_directories:
    parent = relative_dir.parent
    parent_element = directory_elements[parent]
    directory_id = stable_id("DIR", relative_dir.as_posix())

    element = ET.SubElement(
        parent_element,
        q("Directory"),
        {
            "Id": directory_id,
            "Name": relative_dir.name,
        },
    )

    directory_ids[relative_dir] = directory_id
    directory_elements[relative_dir] = element

component_ids: list[str] = []

files_by_directory: dict[Path, list[Path]] = {}
for relative in files:
    files_by_directory.setdefault(relative.parent, []).append(relative)

for relative_dir, directory_files in sorted(
    files_by_directory.items(),
    key=lambda item: item[0].as_posix().lower(),
):
    directory_ref = ET.SubElement(
        product,
        q("DirectoryRef"),
        {
            "Id": directory_ids[relative_dir],
        },
    )

    for relative in sorted(
        directory_files,
        key=lambda p: p.as_posix().lower(),
    ):
        relative_posix = relative.as_posix()
        component_id = stable_id("CMP", relative_posix)
        file_id = stable_id("FIL", relative_posix)
        component_guid = stable_uuid(
            f"MacroObras:Component:{relative_posix.lower()}"
        )

        component = ET.SubElement(
            directory_ref,
            q("Component"),
            {
                "Id": component_id,
                "Guid": component_guid,
                "Win64": "yes",
            },
        )

        file_attributes = {
            "Id": file_id,
            "Name": relative.name,
            "Source": f"$(var.SourceDir)/{relative_posix}",
            "KeyPath": "yes",
            "Vital": "yes",
        }

        if relative.suffix.lower() in {".exe", ".dll"}:
            file_attributes["Checksum"] = "yes"

        ET.SubElement(
            component,
            q("File"),
            file_attributes,
        )

        component_ids.append(component_id)

start_menu_component = "CMP_START_MENU_SHORTCUT"
start_menu_ref = ET.SubElement(
    product,
    q("DirectoryRef"),
    {
        "Id": "PROGRAMMENUDIR",
    },
)

start_menu_cmp = ET.SubElement(
    start_menu_ref,
    q("Component"),
    {
        "Id": start_menu_component,
        "Guid": stable_uuid("MacroObras:StartMenuShortcut"),
        "Win64": "yes",
    },
)

ET.SubElement(
    start_menu_cmp,
    q("Shortcut"),
    {
        "Id": "START_MENU_SHORTCUT",
        "Name": "MacroObras",
        "Description": "ERP da construção Maximus Empreendimentos",
        "Target": "[INSTALLFOLDER]bin\\MacroObras.exe",
        "WorkingDirectory": "INSTALLFOLDER",
        "Advertise": "no",
    },
)

ET.SubElement(
    start_menu_cmp,
    q("RemoveFolder"),
    {
        "Id": "REMOVE_PROGRAM_MENU_DIR",
        "On": "uninstall",
    },
)

ET.SubElement(
    start_menu_cmp,
    q("RegistryValue"),
    {
        "Root": "HKLM",
        "Key": "Software\\MacroObras\\Installer",
        "Name": "StartMenuShortcut",
        "Type": "integer",
        "Value": "1",
        "KeyPath": "yes",
    },
)

desktop_component = "CMP_DESKTOP_SHORTCUT"
desktop_ref = ET.SubElement(
    product,
    q("DirectoryRef"),
    {
        "Id": "DesktopFolder",
    },
)

desktop_cmp = ET.SubElement(
    desktop_ref,
    q("Component"),
    {
        "Id": desktop_component,
        "Guid": stable_uuid("MacroObras:DesktopShortcut"),
        "Win64": "yes",
    },
)

ET.SubElement(
    desktop_cmp,
    q("Shortcut"),
    {
        "Id": "DESKTOP_SHORTCUT",
        "Name": "MacroObras",
        "Description": "ERP da construção Maximus Empreendimentos",
        "Target": "[INSTALLFOLDER]bin\\MacroObras.exe",
        "WorkingDirectory": "INSTALLFOLDER",
        "Advertise": "no",
    },
)

ET.SubElement(
    desktop_cmp,
    q("RegistryValue"),
    {
        "Root": "HKLM",
        "Key": "Software\\MacroObras\\Installer",
        "Name": "DesktopShortcut",
        "Type": "integer",
        "Value": "1",
        "KeyPath": "yes",
    },
)

feature = ET.SubElement(
    product,
    q("Feature"),
    {
        "Id": "MAIN_FEATURE",
        "Title": "MacroObras",
        "Description": "Aplicativo e dependências do MacroObras",
        "Level": "1",
        "Absent": "disallow",
        "AllowAdvertise": "no",
        "Display": "expand",
    },
)

for component_id in component_ids:
    ET.SubElement(
        feature,
        q("ComponentRef"),
        {
            "Id": component_id,
        },
    )

ET.SubElement(
    feature,
    q("ComponentRef"),
    {
        "Id": start_menu_component,
    },
)

ET.SubElement(
    feature,
    q("ComponentRef"),
    {
        "Id": desktop_component,
    },
)

rough = ET.tostring(
    wix,
    encoding="utf-8",
    xml_declaration=True,
)

pretty = minidom.parseString(rough).toprettyxml(
    indent="  ",
    encoding="utf-8",
)

output_wxs.parent.mkdir(parents=True, exist_ok=True)
output_wxs.write_bytes(pretty)

print(f"WXS gerado: {output_wxs}")
print(f"Arquivos incluídos: {len(files)}")
print(f"ProductCode: {product_code}")
print(f"UpgradeCode: {upgrade_code}")
PY

printf '[MSI] Compilando %s\n' "$MSI"

wixl \
  -v \
  -a X64 \
  -D "SourceDir=$PACKAGE_DIR" \
  -o "$MSI" \
  "$WXS"

[[ -s "$MSI" ]] ||
  die "o arquivo MSI não foi gerado."

sha256sum "$MSI" > "$SHA256"

printf '[MSI] Inspecionando metadados\n'
msiinfo suminfo "$MSI"

printf '[MSI] Conferindo conteúdo\n'
msiextract -l "$MSI" > "$WORK_DIR/files-${VERSION}.txt"

printf '\nMSI criado:\n  %s\n' "$MSI"
printf 'SHA-256:\n  %s\n' "$SHA256"
printf 'Lista de arquivos:\n  %s\n' "$WORK_DIR/files-${VERSION}.txt"
