# Copie para config/mobile-platform.env e preencha somente no computador da estação.
MACROOBRAS_ENABLE_NGROK=1

# O ngrok também aceita o token salvo em ~/.config/ngrok/ngrok.yml.
# Não envie este arquivo preenchido ao Git.
NGROK_AUTHTOKEN=

# Opcional: domínio reservado no ngrok.
MACROOBRAS_NGROK_DOMAIN=

# Opcional: caminho explícito do executável.
MACROOBRAS_NGROK_BIN=ngrok

# Porta da estação MacroObras.
MACROOBRAS_HOST=127.0.0.1
MACROOBRAS_PORT=7654
